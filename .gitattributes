# Normalise line endings so Windows, macOS and Linux produce identical diffs.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.ps1 text eol=crlf
*.bat text eol=crlf

# Binary files: never touch.
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.mp4 binary
*.pt binary
*.onnx binary
