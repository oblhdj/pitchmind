    "PlayerStats": {
      "additionalProperties": false,
      "properties": {
        "player_id": {
          "examples": [
            "H10",
            "A1"
          ],
          "pattern": "^[HA]\\d{1,2}$",
          "title": "Player Id",
          "type": "string"
        },
        "team": {
          "$ref": "#/$defs/TeamSide"
        },
