        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        }
      },
      "required": [
        "name",
        "value",
        "unit",
        "label"
      ],
      "title": "OverlayMetric",
      "type": "object"
    },
