{
  "$defs": {
    "AgentName": {
      "enum": [
        "orchestrator",
        "explain",
        "narrative",
        "recap",
        "persona",
        "language",
        "verifier",
        "template"
      ],
      "title": "AgentName",
      "type": "string"
    },
    "Claim": {
      "additionalProperties": false,
      "description": "One factual statement inside an insight, with the evidence that supports it.",
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        },
        "evidence": {
          "items": {
            "minimum": 0,
            "type": "integer"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "metrics": {
          "additionalProperties": {
            "type": "number"
          },
          "default": {},
          "title": "Metrics",
          "type": "object"
        }
      },
      "required": [
        "text",
        "evidence",
        "metrics"
      ],
      "title": "Claim",
      "type": "object"
    },
    "InsightKind": {
      "enum": [
        "explanation",
        "commentary",
        "stat_alert",
        "milestone",
        "recap"
      ],
      "title": "InsightKind",
      "type": "string"
    },
    "Language": {
      "enum": [
        "en",
        "fr",
        "ar",
        "es"
      ],
      "title": "Language",
      "type": "string"
    },
    "MetricName": {
      "enum": [
        "possession_pct",
        "passes",
        "pass_accuracy_pct",
        "pass_difficulty",
        "pass_distance_m",
        "ball_speed_kmh",
        "shot_speed_kmh",
        "player_speed_kmh",
        "distance_covered_m",
        "sprints",
        "shots",
        "shots_on_target",
        "xg",
        "xt",
        "tackles_won",
        "pressure_index",
        "momentum",
        "control_chaos",
        "rhythm_epm"
      ],
      "title": "MetricName",
      "type": "string"
    },
    "Persona": {
      "enum": [
        "analyst",
        "casual",
        "beginner"
      ],
      "title": "Persona",
      "type": "string"
    },
    "Segment": {
      "additionalProperties": false,
      "description": "An audience segment. Agents generate one insight variant per active segment.",
      "properties": {
        "persona": {
          "$ref": "#/$defs/Persona"
        },
        "language": {
          "$ref": "#/$defs/Language"
        },
        "club": {
          "anyOf": [
            {
              "$ref": "#/$defs/TeamSide"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "player": {
          "anyOf": [
            {
              "examples": [
                "H10",
                "A1"
              ],
              "pattern": "^[HA]\\d{1,2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Player"
        },
        "metric_focus": {
          "anyOf": [
            {
              "$ref": "#/$defs/MetricName"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "key": {
          "readOnly": true,
          "title": "Key",
          "type": "string"
        }
      },
      "required": [
        "persona",
        "language",
        "club",
        "player",
        "metric_focus",
        "key"
      ],
      "title": "Segment",
      "type": "object"
    },
    "TeamSide": {
      "enum": [
        "home",
        "away"
      ],
      "title": "TeamSide",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "msg": {
      "const": "insight",
      "default": "insight",
      "title": "Msg",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "match_id": {
      "title": "Match Id",
      "type": "string"
    },
    "moment_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "None for recaps",
      "title": "Moment Id"
    },
    "t": {
      "description": "Seconds of play since kick-off (continuous)",
      "minimum": 0,
      "title": "T",
      "type": "number"
    },
    "kind": {
      "$ref": "#/$defs/InsightKind"
    },
    "segment": {
      "$ref": "#/$defs/Segment"
    },
    "headline": {
      "maxLength": 90,
      "title": "Headline",
      "type": "string"
    },
    "body": {
      "maxLength": 1500,
      "title": "Body",
      "type": "string"
    },
    "claims": {
      "items": {
        "$ref": "#/$defs/Claim"
      },
      "title": "Claims",
      "type": "array"
    },
    "verified": {
      "description": "Passed the Verifier's evidence and number checks",
      "title": "Verified",
      "type": "boolean"
    },
    "fallback": {
      "default": false,
      "description": "Template text used instead of an LLM",
      "title": "Fallback",
      "type": "boolean"
    },
    "agent_trace": {
      "description": "Agents that handled this insight, in order",
      "items": {
        "$ref": "#/$defs/AgentName"
      },
      "title": "Agent Trace",
      "type": "array"
    },
    "model": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model"
    },
    "latency_ms": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Latency Ms"
    }
  },
  "required": [
    "msg",
    "schema_version",
    "id",
    "match_id",
    "moment_id",
    "t",
    "kind",
    "segment",
    "headline",
    "body",
    "claims",
    "verified",
    "fallback",
    "agent_trace",
    "model",
    "latency_ms"
  ],
  "title": "Insight",
  "type": "object"
}
